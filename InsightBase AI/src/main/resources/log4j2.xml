<?xml version="1.0" encoding="UTF-8"?>
<!--
  Log4j2 configuration for InsightBase AI.

  Without this file Log4j2 falls back to a console-only, ERROR-level default and
  prints a "No Log4j 2 configuration file found" warning at startup. This routes
  INFO+ to the console and a rolling file under the same ~/.insightbaseai/logs
  directory that ConfigurationManager already creates.
-->
<Configuration status="WARN">
    <Properties>
        <Property name="LOG_DIR">${sys:user.home}/.insightbaseai/logs</Property>
        <Property name="PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n</Property>
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${PATTERN}"/>
        </Console>

        <RollingFile name="File"
                     fileName="${LOG_DIR}/insightbaseai.log"
                     filePattern="${LOG_DIR}/insightbaseai-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${PATTERN}"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="5 MB"/>
                <TimeBasedTriggeringPolicy/>
            </Policies>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>
    </Appenders>

    <Loggers>
        <!-- Keep third-party libraries quieter than our own code. -->
        <Logger name="dev.langchain4j" level="WARN"/>
        <Logger name="org.apache.pdfbox" level="WARN"/>
        <Logger name="org.apache.poi" level="WARN"/>

        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
        </Root>
    </Loggers>
</Configuration>
